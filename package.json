{
  "name": "ar-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "capture:v5": "node scripts/capture-v5.mjs",
    "capture:v5:dev": "node scripts/capture-v5.mjs --no-server",
    "capture:v5:local": "BASE_URL=http://localhost:3001 node scripts/capture-v5.mjs --no-server",
    "capture:v5:prores": "CAPTURE_CODEC=prores node scripts/capture-v5.mjs",
    "capture:v5:prores:local": "CAPTURE_CODEC=prores BASE_URL=http://localhost:3001 node scripts/capture-v5.mjs --no-server",
    "capture:v5:prores:preset": "CAPTURE_CODEC=prores BASE_URL=http://localhost:3001 node scripts/capture-v5.mjs --no-server --formats=landscape"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "playwright": "^1.52.0"
  }
